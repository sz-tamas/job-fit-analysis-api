meta {
  name: Create analysis from LinkedIn profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/analyses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "jobUrl": "{{jobUrl}}",
    "linkedinProfileUrl": "https://www.linkedin.com/in/your-public-profile"
  }
}
