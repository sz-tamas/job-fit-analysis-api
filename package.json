{
  "name": "job-fit-analysis-api",
  "version": "0.1.0",
  "private": true,
  "description": "A small asynchronous API for analyzing a CV against a LinkedIn job URL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "analyze": "ts-node --transpile-only src/cli/analyze.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "apify-client": "^2.22.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.52.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
